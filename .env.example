# Copy to .env.local and fill in from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose this in client code. Used by API routes to write data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where invite links point (your local site)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: minimum total USD traded on a Polymarket market for it to be included (default 10000)
MIN_MARKET_VOLUME=10000
